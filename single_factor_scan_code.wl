(* ::Title:: *)
(* Complete one-factor seed scan, nV = 96, Sp(1)_R gauging *)

(* ::Text:: *)
(* Evaluate the representation-data cell immediately above this code in the
   companion notebook first. It defines reps with the PAPER's coefficient
   convention: a_R=A_R, b_R=B_R, c_R=C_R. The finished notebook is
   self-contained; this file is the readable source of its scan cell.
   Evaluate everything in a fresh kernel. *)

ClearAll[table2, candidateClasses, groupSymbol, groupIndex, lambda,
  paperRecord, paperReps, repField, classData, solveClass,
  classSummary, showClass,
  checkClass, scanAll, n, s];

If[! ValueQ[reps] || ! ListQ[reps],
  Print["First evaluate the representation-data input cell (reps = ...)."];
  Abort[]
];

(* Each row is {group, p, q, x, y}, numbered in the order of Table 2.
   The basis obeys e.e=1, f.f=-1, a=3e+f, bR=e-4f, b=xe+yf.
   In particular p=3x-y and q=x+4y. The x,y entries are included for
   transparent comparison with the paper; the code checks them below. *)
table2 = {
  {"A3",-77,-4,-24,5}, {"A3",-64,-4,-20,4},
  {"A3",-51,-4,-16,3}, {"A3",-38,-4,-12,2},
  {"A3",-25,-4,-8,1},  {"A3",-12,-4,-4,0},
  {"A4",-28,-5,-9,1},  {"A4",-15,-5,-5,0},
  {"A4",-2,-5,-1,-1},  {"A5",-18,-6,-6,0},
  {"A5",-5,-6,-2,-1},  {"A6",-21,-7,-7,0},
  {"A6",-8,-7,-3,-1},  {"A7",-24,-8,-8,0},
  {"A7",-11,-8,-4,-1}, {"B3",-41,-5,-13,2},
  {"B3",-28,-5,-9,1}, {"B3",-15,-5,-5,0},
  {"B3",-2,-5,-1,-1}, {"B4",-21,-7,-7,0},
  {"B4",-8,-7,-3,-1}, {"B5",-14,-9,-5,-1},
  {"C2",-113,-3,-35,8},{"C2",-100,-3,-31,7},
  {"C2",-87,-3,-27,6}, {"C2",-74,-3,-23,5},
  {"C2",-61,-3,-19,4}, {"C2",-48,-3,-15,3},
  {"C2",-35,-3,-11,2}, {"C2",-22,-3,-7,1},
  {"C2",-9,-3,-3,0},   {"C3",-25,-4,-8,1},
  {"C3",-12,-4,-4,0},  {"C4",-15,-5,-5,0},
  {"C4",-2,-5,-1,-1},  {"C5",-5,-6,-2,-1},
  {"C6",-8,-7,-3,-1},  {"D4",-18,-6,-6,0},
  {"D4",-5,-6,-2,-1},  {"D5",-24,-8,-8,0},
  {"D5",-11,-8,-4,-1},{"D5",2,-8,0,-2},
  {"D7",-10,-12,-4,-2},{"G2",-64,-4,-20,4},
  {"G2",-38,-4,-12,2},{"G2",-25,-4,-8,1},
  {"G2",-12,-4,-4,0}, {"E6",-10,-12,-4,-2}
};

candidateClasses = MapIndexed[
  With[{row = #1, id = First[#2]},
    <|"Class"->id, "G"->row[[1]], "p"->row[[2]],
      "q"->row[[3]], "x"->row[[4]], "y"->row[[5]]|>
  ]&, table2
];

(* The data cell itself now follows the paper:
   tr_R F^2 = a_R tr_fund F^2,
   tr_R F^4 = b_R tr_fund F^4 + c_R (tr_fund F^2)^2 + P_R P(F).
   Thus a_R=A_R, b_R=B_R, c_R=C_R everywhere in this notebook. The
   imported d_R is kept solely as a legacy coordinate for the D4
   Pfaffian; the paper's P_R equals -2 d_R. *)
paperRecord[rules_List] := <|
  "dynkin" -> (dynkin /. rules),
  "dim" -> (dim /. rules),
  "PS" -> (PS /. rules),
  "A_R" -> (a /. rules),
  "B_R" -> (b /. rules),
  "C_R" -> (c /. rules),
  "P_R" -> -2 (d /. rules)
|>;
paperReps = Map[
  Function[groupRule,
    groupRule[[1]] -> Map[
      Function[irRule,irRule[[1]] -> paperRecord[irRule[[2]]]],
      groupRule[[2]]
    ]
  ],reps
];
repField[data_Association,key_String] := data[key];

(* Match a paper group name to the subscripted symbol used by reps.
   No group-theory coefficients are retyped: they all come from reps. *)
groupSymbol[name_String] := Module[{f = StringTake[name,1],
    r = ToExpression[StringDrop[name,1]]},
  Switch[f, "A",Subscript[a,r], "B",Subscript[b,r],
    "C",Subscript[c,r], "D",Subscript[d,r],
    "G",Subscript[g,r], "E",Subscript[e,r], _, $Failed]
];
groupIndex[name_String] := FirstPosition[
  paperReps[[All,1]], groupSymbol[name], Missing["Unknown group",name]
];
lambda[name_String] := Switch[StringTake[name,1],
  "A"|"C",1, "B"|"D"|"G",2, "E",6, _, $Failed
];

(* Numerical checks on the data in the paper's coefficient convention:
   A1: (a,b,c)_fund=(1,0,1/2), directly in reps;
   A3: A_fund=B_fund=1, C_fund=0; A_adj=B_adj=8,C_adj=6;
   G2: (A_7,C_7)=(1,1/4), (A_14,C_14)=(4,5/2);
   D4: P_(8_s)=+1, P_(8_c)=-1. *)
If[{
    {a,b,c} /. reps[[First[FirstPosition[reps[[All,1]],
      Subscript[a,1]]],2,2,2]],
    Lookup[paperReps[[First[groupIndex["A3"]],2,2,2]],
      {"A_R","B_R","C_R"}],
    Lookup[paperReps[[First[groupIndex["A3"]],2,3,2]],
      {"A_R","B_R","C_R"}],
    Lookup[paperReps[[First[groupIndex["G2"]],2,2,2]],
      {"A_R","C_R"}],
    Lookup[paperReps[[First[groupIndex["G2"]],2,3,2]],
      {"A_R","C_R"}],
    Lookup[paperReps[[First[groupIndex["D4"]],2,4,2]],"P_R"],
    Lookup[paperReps[[First[groupIndex["D4"]],2,5,2]],"P_R"]
  } =!= {{1,0,1/2},{1,1,0},{8,8,6},{1,1/4},{4,5/2},1,-1},
  Print["Representation coefficients do not match the paper convention."];
  Abort[]
];

classData[k_Integer] /; 1 <= k <= Length[candidateClasses] := Module[
  {cl = candidateClasses[[k]], pos, group, rs, adj, lam, p, q,
   x, y, bSquared, allowed, mat, target, dimensions, ps},
  {group,p,q,x,y} = Lookup[cl,{"G","p","q","x","y"}];
  pos = groupIndex[group];
  If[MissingQ[pos], Return[$Failed]];
  rs = paperReps[[First[pos],2]];
  adj = rs[[3,2]];                  (* r0 is position 1; adj is 3. *)
  lam = lambda[group];
  bSquared = x^2-y^2;
  If[! TrueQ[{x,y} == {(4 p+q)/13,(3 q-p)/13}] ||
     ! TrueQ[q == -lam repField[adj,"A_R"]/2],
     Print["Inconsistent Table 2 entry or representation data: ",k];
     Return[$Failed]
  ];

  (* The singlet r0 is handled separately as an INTEGER s>=0.
     A pseudoreal irrep is admitted when (dim/2)<=340. *)
  allowed = Select[Rest[rs],
    With[{v = #[[2]]},
      MemberQ[{1,1/2},repField[v,"PS"]] &&
      repField[v,"dim"] repField[v,"PS"] <= 340
    ]&
  ];
  dimensions = repField[#[[2]],"dim"]& /@ allowed;
  ps = repField[#[[2]],"PS"]& /@ allowed;

  (* Columns are the matter contributions (A_R,B_R,C_R,P_R).
     For G!=D4 omit the identically zero Pfaffian row. *)
  mat = Transpose[(Lookup[#[[2]],{"A_R","B_R","C_R","P_R"}]& /@ allowed)];
  target = {repField[adj,"A_R"]-6 p/lam,
            repField[adj,"B_R"],
            repField[adj,"C_R"]+3 bSquared/lam^2,
            repField[adj,"P_R"]};
  If[group =!= "D4", mat = Take[mat,3]; target = Take[target,3]];
  <|"Class"->k,"G"->group,"p"->p,"q"->q,"x"->x,"y"->y,
    "b2"->bSquared,"lambda"->lam,
    "Drones"->93-repField[adj,"dim"],
    "Irreps"->allowed,"Rows"->If[group==="D4",
      {"A_R","B_R","C_R","P_R"},{"A_R","B_R","C_R"}],
    "D"->mat,"tSigma"->target,
    "dim"->dimensions,"PS"->ps|>
];

(* n[j] counts half-hypers for PS=1/2 and full hypers for PS=1;
   m_j = PS_j n[j] is ALWAYS the physical full-hyper unit.
   D.m=tSigma is Eq. (5.18), with P added for D4.
   dim.m+s=340 fixes the integer number s of neutral hypers.
   Solve over integers with nonnegativity and the dimension bound
   is exhaustive for this finite representation menu. *)
solveClass[k_Integer] := Module[
  {data = classData[k], ir, nv, m, eqs, raw, specs},
  If[data === $Failed, Return[$Failed]];
  ir = data["Irreps"];
  nv = Table[n[j],{j,Length[ir]}];
  m = data["PS"] nv;
  eqs = Join[
    Thread[data["D"].m == data["tSigma"]],
    {data["dim"].m+s == 340, s >= 0},
    Thread[nv >= 0]
  ];
  raw = Solve[And @@ eqs,Append[nv,s],Integers];
  If[! ListQ[raw],
    Print["Solver did not return a complete list in class ",k];
    Return[$Failed]
  ];
  specs = Map[Function[sol, Module[{v = m /. sol, singles = s /. sol,
      spectrum},
    If[! TrueQ[data["D"].v == data["tSigma"]] ||
       ! TrueQ[data["dim"].v+singles == 340] ||
       ! TrueQ[singles >= 0],
      Print["Internal anomaly check failed in class ",k]; Abort[]
    ];
    spectrum = Select[
      Table[<|"Label"->ir[[j,1]],
              "Dynkin"->repField[ir[[j,2]],"dynkin"],
              "dim"->data["dim"][[j]], "m"->v[[j]]|>,
            {j,Length[ir]}],
      (# ["m"] > 0)&
    ];
    <|"Class"->k,"G"->data["G"],"p"->data["p"],
      "q"->data["q"],"b"->{data["x"],data["y"]},
      "Drones"->data["Drones"],"Singlets"->singles,
      "HCharged"->340-singles,"Spectrum"->spectrum|>
  ]],raw];
  SortBy[specs,{# ["Singlets"]&, ToString[# ["Spectrum"],InputForm]&}]
];

(* Evaluate scanAll[] to run ALL 48 classes, including the empty ones.
   The output Association has integer class numbers as keys. A stored
   empty list {} means the corresponding candidate is not realized. *)
scanAll[] := Module[{out = Association[], ans},
  Do[
    ans = solveClass[k];
    If[ans === $Failed, Return[$Failed]];
    AssociateTo[out,k->ans];
    Print["Class ",k," (",candidateClasses[[k,"G"]],
      ", p=",candidateClasses[[k,"p"]],
      "): ",Length[ans]," spectra"];
  ,{k,Length[candidateClasses]}];
  out
];

(* Examples after evaluating the code above:
   classData[38]["tSigma"]    signed D4 target, including P_adj
   one = solveClass[38];      one class only
   allByClass = scanAll[];    exhaustive scan, possibly time consuming
   classSummary[allByClass]   ALL 48 rows, including zero-count classes
   showClass[allByClass,38]   inspect every spectrum in class 38
   Put[allByClass,"one_factor_by_class.wl"]   optional local save;
   Get["one_factor_by_class.wl"]              load that result later.
   A single G with drones is an auxiliary seed for spectra assembly,
   not a drone-free physical endpoint. *)
classSummary[byClass_Association] := Table[
  With[{cl = candidateClasses[[k]]},
    {k,cl["G"],cl["p"],cl["q"],
     {cl["x"],cl["y"]}, Length[Lookup[byClass,k,{}]]}
  ],{k,Length[candidateClasses]}];
showClass[byClass_Association,k_Integer] := Lookup[byClass,k,Missing["Class not scanned"]];

(* This is a REFERENCE check, not a substitute for running the scan.
   Table 4 of the supplied latest PDF reports 646 spectra in 38
   nonempty branches, by group as below. If the comparison fails,
   inspect the source menu and the affected classes before reuse. *)
checkClass[byClass_Association] := Module[
  {expected = <|"A3"->187,"A4"->12,"A5"->44,"A6"->7,
     "A7"->5,"B3"->8,"B4"->4,"C2"->279,"C3"->43,
     "C4"->12,"C5"->2,"C6"->1,"D4"->27,"D5"->3,
     "D7"->1,"G2"->10,"E6"->1|>, actual, branches},
  If[Length[byClass] != 48, Return[Missing["Run all 48 classes first"]]];
  actual = Merge[Table[<|candidateClasses[[k,"G"]] -> Length[byClass[k]]|>,
     {k,48}],Total];
  branches = Count[Length /@ Values[byClass],_?(#>0&)];
  <|"ReferenceTotal"->646,"ComputedTotal"->Total[Values[actual]],
    "ReferenceBranches"->38,"ComputedBranches"->branches,
    (* Associations need a structural, key-order-independent comparison.
       Equal (==) is for mathematical equality, not record comparison. *)
    "MatchesPaper"->(KeySort[actual] === KeySort[expected] &&
      branches === 38 && Total[Values[actual]] === 646),
    "GroupComparison"->Association@KeyValueMap[
       #1 -> <|"Computed"->Lookup[actual,#1,0],"Paper"->#2|>&,
       expected]|>
];
